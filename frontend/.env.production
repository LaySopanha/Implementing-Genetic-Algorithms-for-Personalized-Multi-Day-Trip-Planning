# Production API base URL for the frontend (used by `npm run build` on Vercel).
#
# Left empty on purpose: the frontend calls relative `/api/...` paths, and
# `frontend/vercel.json` rewrites `/api/*` to the Hugging Face Space backend.
# This keeps frontend + API under ONE custom subdomain (e.g. saktmor.you.dev)
# with no cross-origin requests and no CORS.
#
# If you ever want the frontend to hit the backend directly instead of via the
# rewrite, set this to the full backend URL, e.g.:
#   VITE_API_URL=https://endercoder-sak-tmor.hf.space
VITE_API_URL=
