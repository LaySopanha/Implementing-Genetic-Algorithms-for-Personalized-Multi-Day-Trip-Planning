ailable,"['Internet', 'Free Internet', 'Restaurant', 'Pool', 'Bar/Lounge', 'Breakfast included', 'Non-smoking rooms', 'Air conditioning', 'Flatscreen TV', 'Outdoor pool', 'Wifi', 'Free Wifi', 'Concierge', 'Family Rooms', 'Non-smoking hotel', 'Safe', 'Breakfast Available', 'Parking', 'Housekeeping', 'ATM On Site', 'Baggage Storage', 'Bath / Shower', 'BBQ Facilities', 'Bicycle Rental', 'Billiards', 'Bottled Water', 'Car Hire', '24-Hour Check-in', 'Chinese', 'Coffee Shop', 'Currency Exchange', 'Desk', 'English', 'Free Public Parking Nearby', '24-Hour Front Desk', 'Hair Dryer', 'Khmer', 'Massage', 'Newspaper', '24-Hour Security', 'Taxi Service']",Not available,Not available,Not available,"{'name': 'hotel', 'localized_name': 'Hotel'}","[{'name': 'bb', 'localized_name': 'Bed and Breakfast'}]",Not available,"['Budget', 'Modern']",[],"[{'name': 'business', 'localized_name': 'Business', 'value': '13'}, {'name': 'couples', 'localized_name': 'Couples', 'value': '120'}, {'name': 'solo', 'localized_name': 'Solo travel', 'value': '91'}, {'name': 'family', 'localized_name': 'Family', 'value': '56'}, {'name': 'friends', 'localized_name': 'Friends getaway', 'value': '165'}]",[],Not available,Not available,FALSE,25,20
Jason's Bicycle Tour of Kampot,here:pds:place:116w3fh6-150afb6f26c2474165ed491b1145d7f7,en,landmark_attraction,"{'label': ""Jason's Bicycle Tour of Kampot, 070801 កំពត, កម្ពុជា"", 'countryCode': 'KHM', 'countryName': 'កម្ពុជា', 'county': 'កំពត', 'city': 'កំពត', 'district': 'កំពង់កណ្ដាល', 'postalCode': '070801'}","{'lat': 10.60643, 'lng': 104.1846}","[{'lat': 10.6063, 'lng': 104.18456}]",19162,"[{'id': '300-3000-0000', 'name': 'Landmark-Attraction', 'primary': True}]",Not available,"[{'supplier': {'id': 'tripadvisor'}, 'id': '26661797'}]","[{'phone': [{'value': '+855962882719'}], 'www': [{'value': 'jasonstour.com'}]}]","[{'text': ['Mon-Sun: 00:00 - 23:30'], 'isOpen': True, 'structured': [{'start': 'T000000', 'duration': 'PT23H30M', 'recurrence': 'FREQ:DAILY;BYDAY:MO,TU,WE,TH,FR,SA,SU'}]}]",Kampot,10.606439,104.184616,26661797,Jason's Bicycle Tour of Kampot,"Not just another bike tour, we aim to provide a complete historical and cultural experience while cycling the scenic Kampot countryside. From the rise of the Khmer Empire to the fall of the Khmer Rouge, our guide will take you through the history of Cambodia as we take frequent breaks. We will tour several different temples while giving explanation of how Buddhism, Animism and Hinduism blend to form the Cambodian world-view, and explain some of Cambodia's fascinating legends and myths. Our tour includes lunch at a local family's home where you can sample some authentic home-cooked Cambodian cuisine. The perfect tour if you've want to know more about the fascinating country of Cambodia.",https://www.tripadvisor.com/Attraction_Review-g608455-d26661797-Reviews-Jason_s_Bicycle_Tour_of_Kampot-Kampot_Kampot_Province.html?m=66827,"{'street1': 'old Market, kampot', 'city': 'Kampot', 'state': 'Kampot Province', 'country': 'Cambodia', 'address_string': 'old Market, kampot, Kampot Cambodia'}","[{'level': 'City', 'name': 'Kampot', 'location_id': '608455'}, {'level': 'Province', 'name': 'Kampot Province', 'location_id': '2366664'}, {'level': 'Country', 'name': 'Cambodia', 'location_id': '293939'}]",Asia/Phnom_Penh,jason@jasonstour.com,+855 96 288 2719,http://jasonstour.com,https://www.tripadvisor.com/UserReview-g608455-d26661797-Jason_s_Bicycle_Tour_of_Kampot-Kampot_Kampot_Province.html?m=66827,"{'geo_location_id': '608455', 'ranking_string': '#10 of 48 Outdoor Activities in Kampot', 'geo_location_name': 'Kampot', 'ranking_out_of': '48', 'ranking': '10'}",5,https://www.tripadvisor.com/img/cdsi/img2/ratings/traveler/5.0-66827-5.svg,20,"{'1': '0', '2': '0', '3': '0', '4': '0', '5': '20'}",Not available,33,https://www.tripadvisor.com/Attraction_Review-g608455-d26661797-m66827-Reviews-Jason_s_Bicycle_Tour_of_Kampot-Kampot_Kampot_Province.html#photos,Not available,"{'periods': [{'open': {'day': 1, 'time': '0000'}, 'close': {'day': 1, 'time': '2359'}}, {'open': {'day': 2, 'time': '0000'}, 'close': {'day': 2, 'time': '2359'}}, {'open': {'day': 3, 'time': '0000'}, 'close': {'day': 3, 'time': '2359'}}, {'open': {'day': 4, 'time': '0000'}, 'close': {'day': 4, 'time': '2359'}}, {'open': {'day': 5, 'time': '0000'}, 'close': {'day': 5, 'time': '2359'}}, {'open': {'day': 6, 'time': '0000'}, 'close': {'day': 6, 'time': '2359'}}, {'open': {'day': 7, 'time': '0000'}, 'close': {'day': 7, 'time': '2359'}}], 'weekday_text': ['Monday: 00:00 - 23:59', 'Tuesday: 00:00 - 23:59', 'Wednesday: 00:00 - 23:59', 'Thursday: 00:00 - 23:59', 'Friday: 00:00 - 23:59', 'Saturday: 00:00 - 23:59', 'Sunday: 00:00 - 23:59']}",Not available,Not available,Not available,Not available,"{'name': 'attraction', 'localized_name': 'Attraction'}","[{'name': 'sightseeing_tours', 'localized_name': 'Tours'}, {'name': 'activities', 'localized_name': 'Activities'}, {'name': 'outdoor_activities', 'localized_name': 'Outdoor Activities'}]","[{'name': 'Tours', 'localized_name': 'Tours', 'categories': [{'name': 'Nature & Wildlife Tours', 'localized_name': 'Nature & Wildlife Tours'}, {'name': 'Sightseeing Tours', 'localized_name': 'Sightseeing Tou