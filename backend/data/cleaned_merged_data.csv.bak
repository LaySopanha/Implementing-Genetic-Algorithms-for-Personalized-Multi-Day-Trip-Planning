0', '2': '1', '3': '0', '4': '0', '5': '1'}",{},11,https://www.tripadvisor.com/Hotel_Review-g297390-d8719357-m66827-Reviews-Lotus_Diamond_Hotel-Siem_Reap_Siem_Reap_Province.html#photos,$,Not available,"['Pool', 'Internet', 'Kids Activities', 'Suites', 'Room service', 'Free Internet', 'Free parking', 'Wheelchair access', 'Restaurant', 'Bar/Lounge', 'Airport transportation', 'Wifi', 'Free Wifi', 'Breakfast included', 'Business center', 'Fitness center']",Not available,Not available,Not available,"{'name': 'hotel', 'localized_name': 'Hotel'}","[{'name': 'bb', 'localized_name': 'Bed and Breakfast'}]",Not available,"['Luxury', 'Mid-range']",[],"[{'name': 'business', 'localized_name': 'Business', 'value': '1'}, {'name': 'couples', 'localized_name': 'Couples', 'value': '0'}, {'name': 'solo', 'localized_name': 'Solo travel', 'value': '0'}, {'name': 'family', 'localized_name': 'Family', 'value': '0'}, {'name': 'friends', 'localized_name': 'Friends getaway', 'value': '1'}]",[],Not available,Not available,FALSE,11,20
LOTUS Lodge,here:pds:place:116w63u5-012e04f39a064110869d7ada852f88a0,en,accommodation,"{'label': 'LOTUS Lodge, 171201 សៀមរាប, កម្ពុជា', 'countryCode': 'KHM', 'countryName': 'កម្ពុជា', 'county': 'សៀមរាម', 'city': 'សៀមរាប', 'district': 'ស្លក្រាម', 'postalCode': '171201'}","{'lat': 13.36642, 'lng': 103.87451}","[{'lat': 13.36655, 'lng': 103.87454}]",22440,"[{'id': '500-5000-0053', 'name': 'Hotel', 'primary': True}, {'id': '700-7460-0115', 'name': 'Tourist Information'}]",Not available,"[{'supplier': {'id': 'tripadvisor'}, 'id': '877813'}]","[{'phone': [{'value': '+85563966140'}, {'value': '+855966203676'}]}]",Not Available,Siem Reap,13.366278,103.87447,877813,Lotus Lodge,"This spacious and family friendly lodge is situated a short distance from the center of Siem Reap. Away from all the big hotels and busy street life, it offers an oasis of greenery. An excellent place for a well deserved and relaxing rest after visiting the temples of Angkor Wat. The Lotus Lodge offers a number of services and amenities to guests staying in one of our 34 clean and quiet rooms. During your stay you can enjoy complimentary Wi-Fi, a poolside restaurant and bar, free bicycle rentals, tour booking service, computer and internet access, pool table, movies, free daily shuttle, as well as our 10 meter high viewing tower which provides a superb panoramic outlook. You can even view the famous Angkor Temples from the tower! The large swimming pool is surrounded by a relaxation area that allows you to retreat to the calmness of the lodge. Massage can be arranged in your room or on the poolside terrace. We offer a wide variety of Khmer, Chinese and western meals in our open air restaurant and lounge. We also provide transfer services from the airport to the resort. Come stay with us at Lotus Lodge and you are sure to have a pleasant and relaxing experience! THE LOTUS LODGE IS OWNED BY JAVIER SAINT PIERRE.",https://www.tripadvisor.com/Hotel_Review-g297390-d877813-Reviews-Lotus_Lodge-Siem_Reap_Siem_Reap_Province.html?m=66827,"{'street1': 'Boeung Dounhpa Village Slar Kram Commune, Chong Kov Sou', 'street2': '', 'city': 'Siem Reap', 'state': 'Siem Reap Province', 'country': 'Cambodia', 'address_string': 'Boeung Dounhpa Village Slar Kram Commune, Chong Kov Sou, Siem Reap Cambodia'}","[{'level': 'Municipality', 'name': 'Siem Reap', 'location_id': '297390'}, {'level': 'Province', 'name': 'Siem Reap Province', 'location_id': '2366676'}, {'level': 'Country', 'name': 'Cambodia', 'location_id': '293939'}]",Asia/Phnom_Penh,Not available,Not available,Not available,https://www.tripadvisor.com/UserReview-g297390-d877813-Lotus_Lodge-Siem_Reap_Siem_Reap_Province.html?m=66827,"{'geo_location_id': '297390', 'ranking_string': '#238 of 763 hotels in Siem Reap', 'geo_location_name': 'Siem Reap', 'ranking_out_of': '763', 'ranking': '238'}",4,https://www.tripadvisor.com/img/cdsi/img2/ratings/traveler/4.0-66827-5.svg,389,"{'1': '13', '2': '26', '3': '41', '4': '100', '5': '209'}","{'0': {'name': 'rate_sleep', 'localized_name': 'Sleep Quality', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss4.5.svg', 'value': '4.5'}, '1': {'name': 'rate_location', 'localized_name': 'Location', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss3.5.svg', 'value': '3.5'}, '2': {'name': 'rate_room', 'localized_name': 'Rooms', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss4.0.svg', 'value': '4.0'}, '3': {'name': 'rate_service', 'localized_name': 'Service', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss4.5.svg', 'value': '4.5'}, '4': {'name': 'rate_value', 'localized_name': 'Value', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss4.5.svg', 'value': '4.5'}, '5': {'name': 'rate_cleanliness', 'localized_name': 'Cleanliness', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss4.0.svg', 'value': '4.0'}}",136,https://www.tripadvisor.com/Hotel_Review-g297390-d877813-m66827-Reviews-L