Kampot Kenny's Guesthouse & Bar,here:pds:place:116d408k-cd7785617c9a0c9e2e6c5b75d8d2ca53,en,guest_house,"{'label': ""Kampot Kenny's Guesthouse & Bar, 070801 កំពត, កម្ពុជា"", 'countryCode': 'KHM', 'countryName': 'កម្ពុជា', 'county': 'កំពត', 'city': 'កំពត', 'district': 'កំពង់កណ្ដាល', 'postalCode': '070801'}","{'lat': 10.60701, 'lng': 104.17975}","[{'lat': 10.60688, 'lng': 104.1798}]",19670,"[{'id': '500-5100-0057', 'name': 'Guest House', 'primary': True}, {'id': '500-5000-0053', 'name': 'Hotel'}, {'id': '500-5100-0055', 'name': 'Hostel'}, {'id': '500-5100-0058', 'name': 'Bed and Breakfast'}]",Not available,"[{'supplier': {'id': 'tripadvisor'}, 'id': '7604904'}]",[{'phone': [{'value': '+855972131306'}]}],Not Available,Kampot,10.606978,104.17976,7604904,Kampot Kenny's Guesthouse & Bar,"Kampot Kenny's is a guesthouse and bar located one minute walk from the riverside right in the center of Kampot. With a low price range the guesthouse offers a good deal for backpackers on a budget. At the bar you can enjoy a couple of drinks, meet other backpackers and play a game of pool.",https://www.tripadvisor.com/Hotel_Review-g608455-d7604904-Reviews-Kampot_Kenny_s_Guesthouse_Bar-Kampot_Kampot_Province.html?m=66827,"{'street1': '19 Street 726, Number', 'city': 'Kampot', 'state': 'Kampot Province', 'country': 'Cambodia', 'postalcode': '07000', 'address_string': '19 Street 726, Number, Kampot 07000 Cambodia'}","[{'level': 'City', 'name': 'Kampot', 'location_id': '608455'}, {'level': 'Province', 'name': 'Kampot Province', 'location_id': '2366664'}, {'level': 'Country', 'name': 'Cambodia', 'location_id': '293939'}]",Asia/Phnom_Penh,Not available,Not available,Not available,https://www.tripadvisor.com/UserReview-g608455-d7604904-Kampot_Kenny_s_Guesthouse_Bar-Kampot_Kampot_Province.html?m=66827,"{'geo_location_id': '608455', 'ranking_string': '#38 of 148 B&Bs / Inns in Kampot', 'geo_location_name': 'Kampot', 'ranking_out_of': '148', 'ranking': '38'}",4.5,https://www.tripadvisor.com/img/cd