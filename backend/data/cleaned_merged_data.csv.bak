PP,https://www.tripadvisor.com/UserReview-g293940-d7805891-Farm_to_Table-Phnom_Penh.html?m=66827,"{'geo_location_id': '293940', 'ranking_string': '#56 of 1,983 Places to Eat in Phnom Penh', 'geo_location_name': 'Phnom Penh', 'ranking_out_of': '1983', 'ranking': '56'}",4.5,https://www.tripadvisor.com/img/cdsi/img2/ratings/traveler/4.5-66827-5.svg,315,"{'1': '3', '2': '9', '3': '35', '4': '81', '5': '187'}","{'0': {'name': 'rate_atmosphere', 'localized_name': 'Atmosphere', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss4.5.svg', 'value': '4.5'}, '1': {'name': 'rate_food', 'localized_name': 'Food', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss4.0.svg', 'value': '4.0'}, '2': {'name': 'rate_service', 'localized_name': 'Service', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss4.0.svg', 'value': '4.0'}, '3': {'name': 'rate_value', 'localized_name': 'Value', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss4.0.svg', 'value': '4.0'}}",193,https://www.tripadvisor.com/Restaurant_Review-g293940-d7805891-m66827-Reviews-Farm_to_Table-Phnom_Penh.html#photos,$$ - $$$,"{'periods': [{'open': {'day': 1, 'time': '0800'}, 'close': {'day': 1, 'time': '2200'}}, {'open': {'day': 2, 'time': '0800'}, 'close': {'day': 2, 'time': '2200'}}, {'open': {'day': 3, 'time': '0800'}, 'close': {'day': 3, 'time': '2200'}}, {'open': {'day': 4, 'time': '0800'}, 'close': {'day': 4, 'time': '2200'}}, {'open': {'day': 5, 'time': '0800'}, 'close': {'day': 5, 'time': '2200'}}, {'open': {'day': 6, 'time': '0800'}, 'close': {'day': 6, 'time': '2200'}}, {'open': {'day': 7, 'time': '0800'}, 'close': {'day': 7, 'time': '2200'}}], 'weekday_text': ['Monday: 08:00 - 22:00', 'Tuesday: 08:00 - 22:00', 'Wednesday: 08:00 - 22:00', 'Thursday: 08:00 - 22:00', 'Friday: 08:00 - 22:00', 'Saturday: 08:00 - 22:00', 'Sunday: 08:00 - 22:00']}","['Cash Only', 'Free Wifi', 'Highchairs Available', 'Live Music', 'Outdoor Seating', 'Reservations