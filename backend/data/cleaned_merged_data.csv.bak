Chan Angkor Boutique,here:pds:place:116w63u5-c29eb4558c21426181c470e2eca7ee8a,en,guest_house,"{'label': 'Chan Angkor Boutique, 171203 សៀមរាប, កម្ពុជា', 'countryCode': 'KHM', 'countryName': 'កម្ពុជា', 'county': 'សៀមរាម', 'city': 'សៀមរាប', 'district': 'គោកចក', 'postalCode': '171203'}","{'lat': 13.38125, 'lng': 103.84582}","[{'lat': 13.38123, 'lng': 103.84596}]",23387,"[{'id': '500-5100-0057', 'name': 'Guest House', 'primary': True}]",Not available,"[{'supplier': {'id': 'tripadvisor'}, 'id': '12486206'}]","[{'phone': [{'value': '+85512215366'}], 'www': [{'value': 'http://chanangkorboutique.com'}]}]",Not Available,Siem Reap,13.381332,103.84594,12486206,Chan Angkor Boutique,"Chan Angkor Boutique is in safe, and quiet zone. It is located in the heart of the Siem Reap city, and close to Angkor Wat Temple. The accommodation is Khmer traditional stylist and great decoration.",https://www.tripadvisor.com/Hotel_Review-g297390-d12486206-Reviews-Chan_Angkor_Boutique-Siem_Reap_Siem_Reap_Province.html?m=66827,"{'street1': 'Street 30, Kok Chok', 'city': 'Siem Reap', 'state': 'Siem Reap Province', 'country': 'Cambodia', 'postalcode': '17252', 'address_string': 'Street 30, Kok Chok, Siem Reap 17252 Cambodia'}","[{'level': 'Municipality', 'name': 'Siem Reap', 'location_id': '297390'}, {'level': 'Province', 'name': 'Siem Reap Province', 'location_id': '2366676'}, {'level': 'Country', 'name': 'Cambodia', 'location_id': '293939'}]",Asia/Phnom_Penh,Not available,Not available,Not available,https://www.tripadvisor.com/UserReview-g297390-d12486206-Chan_Angkor_Boutique-Siem_Reap_Siem_Reap_Province.html?m=66827,"{'geo_location_id': '297390', 'ranking_string': '#253 of 644 B&Bs / Inns in Siem Reap', 'geo_location_name': 'Siem Reap', 'ranking_out_of': '644', 'ranking': '253'}",4,https://www.tripadvisor.com/img/cdsi/img2/ratings/traveler/4.0-66827-5.svg,16,"{'1': '3', '2': '0', '3': '0', '4': '3', '5': '10'}","{'0': {'name': 'rate_location', 'localized_name': 'Location', 'rating_image_url': 'htt