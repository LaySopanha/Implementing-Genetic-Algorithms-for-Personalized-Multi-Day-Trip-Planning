Kampot Riverinn Boutique Hotel,here:pds:place:116w3fh6-15fd70e5f5955de75cf2e2ec67a99cd8,en,accommodation,"{'label': 'Kampot Riverinn Boutique Hotel, 070801 កំពត, កម្ពុជា', 'countryCode': 'KHM', 'countryName': 'កម្ពុជា', 'county': 'កំពត', 'city': 'កំពត', 'district': 'កំពង់កណ្ដាល', 'postalCode': '070801'}","{'lat': 10.60014, 'lng': 104.18846}","[{'lat': 10.60014, 'lng': 104.18846}]",18489,"[{'id': '500-5000-0053', 'name': 'Hotel', 'primary': True}]",Not available,"[{'supplier': {'id': 'tripadvisor'}, 'id': '25353351'}]","[{'phone': [{'value': '+85516818424'}], 'www': [{'value': 'https://kampotriverinn.com'}]}]",Not Available,Kampot,10.599975,104.188736,25353351,Kampot Riverinn Boutique Hotel,"Kampot RiverInn Boutique Hotel, located in the heart of Kampot Town along Kampot River, is the first standard boutique hotel in the coastal town. Kampot RiverInn Boutique Hotel is situated on one of the town’s largest streets.",https://www.tripadvisor.com/Hotel_Review-g608455-d25353351-Reviews-Kampot_Riverinn_Boutique_Hotel-Kampot_Kampot_Province.html?m=66827,"{'street1': 'Riverside Road', 'street2': 'Phum Sovansakor', 'city': 'Kampot', 'state': 'Kampot Province', 'country': 'Cambodia', 'postalcode': '070801', 'address_string': 'Riverside Road Phum Sovansakor, Kampot 070801 Cambodia'}","[{'level': 'City', 'name': 'Kampot', 'location_id': '608455'}, {'level': 'Province', 'name': 'Kampot Province', 'location_id': '2366664'}, {'level': 'Country', 'name': 'Cambodia', 'location_id': '293939'}]",Asia/Phnom_Penh,Not available,Not available,Not available,https://www.tripadvisor.com/UserReview-g608455-d25353351-Kampot_Riverinn_Boutique_Hotel-Kampot_Kampot_Province.html?m=66827,Not available,0,Not available,Not available,Not available,{},0,https://www.tripadvisor.com/Hotel_Review-g608455-d25353351-m66827-Reviews-Kampot_Riverinn_Boutique_Hotel-Kampot_Kampot_Province.html#photos,$$,Not available,[],Not available,Not available,Not available,"{'name': 'hotel', 'localized_name': 'Hotel'}","[{'n