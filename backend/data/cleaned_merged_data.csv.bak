Woody's,here:pds:place:116w3csh-836dc0bb25a142b18802ddbc08300556,en,bed_and_breakfast,"{'label': ""Woody's, 180404 ព្រះសីហនុ, កម្ពុជា"", 'countryCode': 'KHM', 'countryName': 'កម្ពុជា', 'county': 'ព្រះសីហនុ', 'city': 'ព្រះសីហនុ', 'district': 'បួន', 'postalCode': '180404'}","{'lat': 10.56928, 'lng': 103.5592}","[{'lat': 10.56935, 'lng': 103.55932}]",134827,"[{'id': '500-5100-0058', 'name': 'Bed and Breakfast', 'primary': True}, {'id': '100-1000-0000', 'name': 'Restaurant'}, {'id': '100-1100-0010', 'name': 'Coffee Shop'}, {'id': '200-2000-0011', 'name': 'Bar or Pub'}]","[{'id': '304-000', 'name': 'Italian', 'primary': True}]","[{'supplier': {'id': 'tripadvisor'}, 'id': '13417335'}]","[{'phone': [{'value': '+85510402179'}], 'www': [{'value': 'http://www.facebook.com/theotresproject', 'categories': [{'id': '500-5100-0058'}]}, {'value': 'https://www.booking.com/hotel/kh/woodys.html', 'categories': [{'id': '100-1000-0000'}, {'id': '100-1100-0010'}, {'id': '200-2000-0011'}]}]}]",Not Available,Preah Sihanouk,10.569283,103.5592,13417335,Woody’s,"Situated a short stroll away from the beach, in the heart of Otres village on the busy & vibrant ‘Sok Boulevard’, we offer luxury mini-house accommodation suitable for up to 3 people comprising of double & single bed & all modern conveniences & amenities (brand new Samsung air-con, refrigerator, kettle, hot shower room etc.). Our comfortable, relaxed bar is unique in offering craft ales (IPA, APA, Irish Red etc.) alongside a variety of in-house cocktails & standard pub fayre. Globetrotters Italian restaurant facilitates our in-house lunch & dinner options with Eastern European special options & homemade desserts. We host a variety of daily events throughout the season including our infamous Friday Night Pub Quiz/Trivia, games nights, movie nights & more. Wing it down to Woody’s & explore everything Otres & the surrounding areas has to offer!",https://www.tripadvisor.com/Hotel_Review-g325573-d13417335-Reviews-Woody_s-Sihanoukville_Sihanoukville_Province.html?m=66827,"{'street2': 'Otres Village', 'city': 'Sihanoukville', 'state': 'Sihanoukville Province', 'country': 'Cambodia', 'postalcode': '18000', 'address_string': 'Otres Village, Sihanoukville 18000 Cambodia'}","[{'level': 'Municipality', 'name': 'Sihanoukville', 'location_id': '325573'}, {'level': 'Province', 'name': 'Sihanoukville Province', 'location_id': '3698381'}, {'level': 'Country', 'name': 'Cambodia', 'location_id': '293939'}]",Asia/Phnom_Penh,Not available,Not available,Not available,https://www.tripadvisor.com/UserReview-g325573-d13417335-Woody_s-Sihanoukville_Sihanoukville_Province.html?m=66827,"{'geo_location_id': '325573', 'ranking_string': '#11 of 304 B&Bs / Inns in Sihanoukville', 'geo_location_name': 'Sihanoukville', 'ranking_out_of': '304', 'ranking': '11'}",5,https://www.tripadvisor.com/img/cdsi/img2/ratings/traveler/5.0-66827-5.svg,48,"{'1': '1', '2': '0', '3': '0', '4': '3', '5': '44'}","{'0': {'name': 'rate_location', 'localized_name': 'Location', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss5.0.svg', 'value': '5.0'}, '1': {'name': 'rate_sleep', 'localized_name': 'Sleep Quality', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss5.0.svg', 'value': '5.0'}, '2': {'name': 'rate_room', 'localized_name': 'Rooms', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss5.0.svg', 'value': '5.0'}, '3': {'name': 'rate_service', 'localized_name': 'Service', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss5.0.svg', 'value': '5.0'}, '4': {'name': 'rate_value', 'localized_name': 'Value', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss5.0.svg', 'value': '5.0'}, '5': {'name': 'rate_cleanliness', 'localized_name': 'Cleanliness', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss5.0.svg', 'value': '5.0'}}",54,https://www.tripadvisor.com/Hotel_Review-g325573-d13417335-m66827-Reviews-Woody_s-Sihanoukville_Sihanoukville_Province.html#photos,Not available,Not available,"['Internet', 'Suites', 'Free Internet', 'Restaurant', 'Bar/Lounge', 'Wifi', 'Public Wifi', 'Free Wifi', 'Multilingual Staff', 'Kids Activities', 'Free parking', 'Pets Allowed', 'Non-smoking rooms', 'Air conditioning', 'Family Rooms', 'Accessible rooms', 'Refrigerator in room', 'Non-smoking hotel', 'Breakfast Available', 'Housekeeping', 'Bath / Shower', 'BBQ Facilities', 'Board Games / Puzzles', 'Clothes Rack', 'Coffee / Tea Maker', 'Danish', 'Dutch', 'English', 'Evening Entertainment', 'Complimentary Toiletries', 'French', 'Korean', 'Outdoor Fireplace', 'Outdoor Furniture', 'Russian', 'Seating Area', 'Secured Parking', 'Street Parking', 'Wine / Champagne']",Not available,Not available,Not available,"{'name': 'hotel', 'localized_name': 'Hotel'}","[{'name': 'bb', 'localized_name': 'Bed and Breakfast'}]",Not available,"['Trendy', 'Charming']",[],"[{'name': 'business', 'localized_name': 'Business', 'value': '0'}, {'name': 'couples', 'localized_name': 'Couples', 'value': '13'}, {'name': 'solo', 'localized_name': 'Solo travel', 'value': '15'}, {'name': 'family', 'localized_name': 'Family', 'value': '4'}, {'name': 'friends', 'localized_name': 'Friends getaway', 'value': '13'}]",[],Not available,Not available,FALSE,16,15
Woody's Quads Cambodia,here:pds:place:116w3cs7-471d572fcf6e4948adab18a87935117c,en,tourist_attraction,"{'label': ""Woody's Quads Cambodia, 180403 ព្រះសីហនុ, កម្ពុជា"", 'countryCode': 'KHM', 'countryName': 'កម្ពុជា', 'county': 'ព្រះសីហនុ', 'city': 'ព្រះសីហនុ', 'district': 'បី', 'postalCode': '180403'}","{'lat': 10.62992, 'lng': 103.51076}","[{'lat': 10.6299, 'lng': 103.51075}]",180784,"[{'id': '300-3000-0023', 'name': 'Tourist Attraction', 'primary': True}]",Not available,"[{'supplier': {'id': 'tripadvisor'}, 'id': '7095117'}]","[{'phone': [{'value': '+85570417446'}], 'www': [{'value': 'https://www.facebook.com/Woodys-quads-cambodia-445297435801414'}]}]","[{'text': ['Mon-Sun: 08:00 - 20:00'], 'isOpen': False, 'structured': [{'start': 'T080000', 'duration': 'PT12H00M', 'recurrence': 'FREQ:DAILY;BYDAY:MO,TU,WE,TH,FR,SA,SU'}]}]",Preah Sihanouk,10.629922,103.51076,7095117,Woody's Quads Cambodia,"""KOH RONG'S No.1 OUTDOOR ACTIVITY"" Join us on new specially designed woodland course for our TIME TRIAL EVENT @ ONLY $10 per rider This is an attraction not to be missed !! TOURS FROM $30 PER PERSON Have the exhilarating experience of riding a Quad Bike along woodland dirt tracks & crossing wooden bridges on the beautiful island of Koh Rong. Visit rural homestead's, Dam Skal fishing village and see the amazing vista of Longset Bay Family tours available No experience of riding a Quad Bike is required !! AFTERNOON ADVENTURE ( duration 1 - 1.5 hours) $30 per rider Start Time 4.30 pm NATURE BEACH & TRACKS ( duration 2 - 2.5 hours) $55 per rider Start Time 10.00 am, 1.30 pm & 4.00 pm DAM SKAL ADVENTURE ( duration 3 - 3.5 hours) $75 per rider Start Time 9.30 am & 2.30 pm All tours are fully guided Tour meeting point : Longset Beach Pier",https://www.tripadvisor.com/Attraction_Review-g1808558-d7095117-Reviews-Woody_s_Quads_Cambodia-Koh_Rong_Koh_Kong_Province.html?m=66827,"{'city': 'Koh Rong', 'state': 'Koh Kong Province', 'country': 'Cambodia', 'postalcode': '18000', 'address_string': 'Koh Rong 18000 Cambodia'}","[{'level': 'Island', 'name': 'Koh Rong', 'location_id': '1808558'}, {'level': 'Province', 'name': 'Koh Kong Province', 'location_id': '2366667'}, {'level': 'Country', 'name': 'Cambodia', 'location_id': '293939'}]",Asia/Phnom_Penh,woodys.atvs@gmail.com,+855 70 417 446,https://www.facebook.com/Woodys-quads-cambodia-445297435801414/,https://www.tripadvisor.com/UserReview-g1808558-d7095117-Woody_s_Quads_Cambodia-Koh_Rong_Koh_Kong_Province.html?m=66827,"{'geo_location_id': '1808558', 'ranking_string': '#2 of 18 things to do in Koh Rong', 'geo_location_name': 'Koh Rong', 'ranking_out_of': '18', 'ranking': '2'}",5,https://www.tripadvisor.com/img/cdsi/img2/ratings/traveler/5.0-66827-5.svg,209,"{'1': '2', '2': '1', '3': '0', '4': '4', '5': '202'}",Not available,262,https://www.tripadvisor.com/Attraction_Review-g1808558-d7095117-m66827-Reviews-Woody_s_Quads_Cambodia-Koh_Rong_Koh_Kong_Province.html#photos,Not available,"{'periods': [{'open': {'day': 1, 'time': '0800'}, 'close': {'day': 1, 'time': '2000'}}, {'open': {'day': 2, 'time': '0800'}, 'close': {'day': 2, 'time': '2000'}}, {'open': {'day': 3, 'time': '0800'}, 'close': {'day': 3, 'time': '2000'}}, {'open': {'day': 4, 'time': '0800'}, 'close': {'day': 4, 'time': '2000'}}, {'open': {'day': 5, 'time': '0800'}, 'close': {'day': 5, 'time': '2000'}}, {'open': {'day': 6, 'time': '0800'}, 'close': {'day': 6, 'time': '2000'}}, {'open': {'day': 7, 'time': '0800'}, 'close': {'day': 7, 'time': '2000'}}], 'weekday_text': ['Monday: 08:00 - 20:00', 'Tuesday: 08:00 - 20:00', 'Wednesday: 08:00 - 20:00', 'Thursday: 08:00 - 20:00', 'Friday: 08:00 - 20:00', 'Saturday: 08:00 - 20:00', 'Sunday: 08:00 - 20:00']}",Not available,Not available,Not available,Not available,"{'name': 'attraction', 'localized_name': 'Attraction'}","[{'name': 'sightseeing_tours', 'localized_name': 'Tours'}, {'name': 'activities', 'localized_name': 'Activities'}, {'name': 'outdoor_activities', 'localized_name': 'Outdoor Activities'}]","[{