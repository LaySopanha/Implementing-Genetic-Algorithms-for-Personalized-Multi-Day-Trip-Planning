940-d456198-Bougainvillier_Hotel-Phnom_Penh.html?m=66827,"{'geo_location_id': '293940', 'ranking_string': '#94 of 528 hotels in Phnom Penh', 'geo_location_name': 'Phnom Penh', 'ranking_out_of': '528', 'ranking': '94'}",4,https://www.tripadvisor.com/img/cdsi/img2/ratings/traveler/4.0-66827-5.svg,431,"{'1': '22', '2': '39', '3': '78', '4': '175', '5': '117'}","{'0': {'name': 'rate_location', 'localized_name': 'Location', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss4.5.svg', 'value': '4.5'}, '1': {'name': 'rate_sleep', 'localized_name': 'Sleep Quality', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss4.0.svg', 'value': '4.0'}, '2': {'name': 'rate_room', 'localized_name': 'Rooms', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss4.0.svg', 'value': '4.0'}, '3': {'name': 'rate_service', 'localized_name': 'Service', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss4.0.svg', 'value': '4.0'}, '4': {'name': 'rate_value', 'localized_name': 'Value', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss3.5.svg', 'value': '3.5'}, '5': {'name': 'rate_cleanliness', 'localized_name': 'Cleanliness', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss4.0.svg', 'value': '4.0'}}",205,https://www.tripadvisor.com/Hotel_Review-g293940-d456198-m66827-Reviews-Bougainvillier_Hotel-Phnom_Penh.html#photos,$,Not available,"['Internet', 'Free Internet', 'Wifi', 'Free Wifi', 'Breakfast included', 'Non-smoking rooms', 'Laundry Service', 'Air conditioning', 'Multilingual Staff', 'Safe', 'Rooftop Bar', 'Flatscreen TV', 'Rooftop Terrace', 'Breakfast Buffet', 'Private Balcony', 'Shuttle Bus Service', 'Suites', 'Room service', 'Restaurant', 'Bar/Lounge', 'Pets Allowed', 'Airport transportation', 'Dry Cleaning', 'Concierge', 'Minibar']",Not available,Not available,Not available,"{'name': 'hotel', 'localized_name': 'Hotel'}","[{'name': 'hotel', 'localized_name': 'Hotel'}]",Not avai