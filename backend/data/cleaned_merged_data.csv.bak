La Plantation,here:pds:place:116w3fh6-c7476338ef92452fbfdc0d6e151f983a,en,museum,"{'label': 'La Plantation, 070801 កំពត, កម្ពុជា', 'countryCode': 'KHM', 'countryName': 'កម្ពុជា', 'county': 'កំពត', 'city': 'កំពត', 'district': 'កំពង់កណ្ដាល', 'postalCode': '070801'}","{'lat': 10.60807, 'lng': 104.18095}","[{'lat': 10.6082, 'lng': 104.18091}]",105592,"[{'id': '300-3100-0028', 'name': 'History Museum', 'primary': True}, {'id': '300-3100-0000', 'name': 'Museum'}]",Not available,"[{'supplier': {'id': 'tripadvisor'}, 'id': '18083373'}, {'supplier': {'id': 'tripadvisor'}, 'id': '19296749'}]","[{'phone': [{'value': '+85517842505'}], 'www': [{'value': 'http://kampotpepper.com'}]}]",Not Available,Kampot,10.608099,104.18095,18083373,La Plantation,"La Plantation Kampot Museum is the first museum in the world dedicated exclusively to pepper mill and its history, and one of the main museum institutions in this city and province in southeastern Cambodia. We invite you to discover the history of the utensil that made Kampot pepper known and used all over the world.",https://www.tripadvisor.com/Attraction_Review-g608455-d18083373-Reviews-La_Plantation-Kampot_Kampot_Province.html?m=66827,"{'street1': '724a H49, Street', 'city': 'Kampot', 'state': 'Kampot Province', 'country': 'Cambodia', 'postalcode': '07000', 'address_string': '724a H49, Street, Kampot 07000 Cambodia'}","[{'level': 'City', 'name': 'Kampot', 'location_id': '608455'}, {'level': 'Province', 'name': 'Kampot Province', 'location_id': '2366664'}, {'level': 'Country', 'name': 'Cambodia', 'location_id': '293939'}]",Asia/Phnom_Penh,musee@laplantation-kampot.com,+855 17 842 505,http://kampotpepper.com,https://www.tripadvisor.com/UserReview-g608455-d18083373-La_Plantation-Kampot_Kampot_Province.html?m=66827,"{'geo_location_id': '608455', 'ranking_string': '#12 of 34 things to do in Kampot', 'geo_location_name': 'Kampot', 'ranking_out_of': '34', 'ranking': '12'}",5,https://www.tripadvisor.com/img/cdsi/img2/ratings/traveler/5.0-66