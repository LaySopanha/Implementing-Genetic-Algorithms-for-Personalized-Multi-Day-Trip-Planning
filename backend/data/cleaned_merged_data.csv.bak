, Pich Nil', 'street2': 'Near Kirirom on Highway 4, halfway between Phnom Penh & Sihanoukville', 'city': 'Kampong Speu', 'state': 'Kampong Speu Province', 'country': 'Cambodia', 'postalcode': '12000', 'address_string': 'National Highway 4, Pich Nil Near Kirirom on Highway 4, halfway between Phnom Penh & Sihanoukville, Kampong Speu 12000 Cambodia'}","[{'level': 'City', 'name': 'Kampong Speu', 'location_id': '729357'}, {'level': 'Province', 'name': 'Kampong Speu Province', 'location_id': '2366659'}, {'level': 'Country', 'name': 'Cambodia', 'location_id': '293939'}]",Asia/Phnom_Penh,cherylmpadilla@gmail.com,+855 93 544 625,http://the-stop-cafe-rest-stop-pich-nil.business.site,https://www.tripadvisor.com/UserReview-g729357-d10713371-The_Stop_Cafe_Rest_Stop-Kampong_Speu_Kampong_Speu_Province.html?m=66827,"{'geo_location_id': '729357', 'ranking_string': '#1 of 8 Places to Eat in Kampong Speu', 'geo_location_name': 'Kampong Speu', 'ranking_out_of': '8', 'ranking': '1'}",4,https://www.tripadvisor.com/img/cdsi/img2/ratings/traveler/4.0-66827-5.svg,153,"{'1': '12', '2': '2', '3': '14', '4': '33', '5': '92'}","{'0': {'name': 'rate_food', 'localized_name': 'Food', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss4.0.svg', 'value': '4.0'}, '1': {'name': 'rate_service', 'localized_name': 'Service', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss4.5.svg', 'value': '4.5'}, '2': {'name': 'rate_value', 'localized_name': 'Value', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss4.0.svg', 'value': '4.0'}}",152,https://www.tripadvisor.com/Restaurant_Review-g729357-d10713371-m66827-Reviews-The_Stop_Cafe_Rest_Stop-Kampong_Speu_Kampong_Speu_Province.html#photos,$$ - $$$,"{'periods': [{'open': {'day': 1, 'time': '0600'}, 'close': {'day': 1, 'time': '2000'}}, {'open': {'day': 2, 'time': '0600'}, 'close': {'day': 2, 'time': '2000'}}, {'open': {'day': 3, 'time': '0600'}, 'close': {'day': 3, 'time': '2000'}}, {'open': {'day': 4, '