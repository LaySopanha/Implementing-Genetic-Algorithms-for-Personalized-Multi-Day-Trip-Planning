Dolphies Splash Waterpark,here:pds:place:116w3fhd-83a225ccac55420dbb2d20ab51a012ab,en,leisure_outdoor,"{'label': 'Dolphies Splash Waterpark, កម្ពុជា', 'countryCode': 'KHM', 'countryName': 'កម្ពុជា'}","{'lat': 10.67323, 'lng': 104.15976}","[{'lat': 10.67323, 'lng': 104.15976}]",125704,"[{'id': '800-8600-0000', 'name': 'Sports Facility/Venue', 'primary': True}, {'id': '550-5520-0357', 'name': 'Water Park'}]",Not available,Not Available,[{'phone': [{'value': '+85589846763'}]}],Not Available,Kampot,10.66454,104.14389,12146379,Arcadia Waterpark,"Arcadia Backpackers and Waterpark Adventure seekers welcome. We boast Cambodia's first river-side water park. Facilities include: A huge water slide, crazy Russian Swing, Cambodia's first ""Blob"", rope swing, 3m and 6m jumping platforms, massive pontoon for chilling, sundecks, and inner tubes. Also available are kayaks for rent ($5 each), a river cruise on a traditional long boat ($6) and guided hikes ($8).",https://www.tripadvisor.com/Attraction_Review-g608455-d12146379-Reviews-Arcadia_Waterpark-Kampot_Kampot_Province.html?m=66827,"{'street1': 'Teuk Chhu Road', 'street2': '100m before the Zoo', 'city': 'Kampot', 'state': 'Kampot Province', 'country': 'Cambodia', 'postalcode': '07000', 'address_string': 'Teuk Chhu Road 100m before the Zoo, Kampot 07000 Cambodia'}","[{'level': 'City', 'name': 'Kampot', 'location_id': '608455'}, {'level': 'Province', 'name': 'Kampot Province', 'location_id': '2366664'}, {'level': 'Country', 'name': 'Cambodia', 'location_id': '293939'}]",Asia/Phnom_Penh,arcadiabackpackerskampot@gmail.com,+855 97 745 5073,http://www.arcadiabackpackers.com,https://www.tripadvisor.com/UserReview-g608455-d12146379-Arcadia_Waterpark-Kampot_Kampot_Province.html?m=66827,"{'geo_location_id': '608455', 'ranking_string': '#11 of 34 things to do in Kampot', 'geo_location_name': 'Kampot', 'ranking_out_of': '34', 'ranking': '11'}",4.5,https://www.tripadvisor.com/img/cdsi/img2/ratings/traveler/4.5-66827-5.svg,47,"{'1': '0', '2':