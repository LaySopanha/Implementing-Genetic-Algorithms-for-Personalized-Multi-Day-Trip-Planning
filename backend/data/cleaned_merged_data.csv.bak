CS-Tours,here:pds:place:116w3cse-2c4ff49d77e7b8bb6e9ada1d5a22cb01,en,landmark_attraction,"{'label': 'CS-Tours, 180403 ព្រះសីហនុ, កម្ពុជា', 'countryCode': 'KHM', 'countryName': 'កម្ពុជា', 'county': 'ព្រះសីហនុ', 'city': 'ព្រះសីហនុ', 'district': 'បី', 'postalCode': '180403'}","{'lat': 10.64269, 'lng': 103.50145}","[{'lat': 10.6427, 'lng': 103.50159}]",92821,"[{'id': '800-8200-0295', 'name': 'Training & Development', 'primary': True}, {'id': '300-3000-0000', 'name': 'Landmark-Attraction'}, {'id': '700-7400-0133', 'name': 'Travel Agent/Ticketing'}]",Not available,"[{'supplier': {'id': 'tripadvisor'}, 'id': '8525957'}]","[{'phone': [{'value': '+855965959592'}], 'www': [{'value': 'http://cambodiasihanoukvilletours.com'}]}]","[{'text': ['Mon-Sun: 07:00 - 21:00'], 'isOpen': False, 'structured': [{'start': 'T070000', 'duration': 'PT14H00M', 'recurrence': 'FREQ:DAILY;BYDAY:MO,TU,WE,TH,FR,SA,SU'}]}]",Preah Sihanouk,10.642692,103.50151,8525957,CS-Tours,"Cambodia Sihanoukville Tours (CS-Tours),The Cambodia Experience, and bring all my dear visitors to see some of interesting sites here. I organize Tours of the historical centre of Sihanoukville, and offer you many opportunities of a full immersion into the history and the beauty of my city, and the customs of its inhabitants. Typical stops include: Fishing Village, Upper/Lower Pagodas, Preah Thong Neang Neak Roundabout, Kbal Chhay Waterfall,Pshar Leu Market, Beaches and so on.",https://www.tripadvisor.com/Attraction_Review-g325573-d8525957-Reviews-CS_Tours-Sihanoukville_Sihanoukville_Province.html?m=66827,"{'city': 'Sihanoukville', 'state': 'Sihanoukville Province', 'country': 'Cambodia', 'postalcode': '18000', 'address_string': 'Sihanoukville 18000 Cambodia'}","[{'level': 'Municipality', 'name': 'Sihanoukville', 'location_id': '325573'}, {'level': 'Province', 'name': 'Sihanoukville Province', 'location_id': '3698381'}, {'level': 'Country', 'name': 'Cambodia', 'location_id': '293939'}]",Asia/Phnom_Penh,info@cambodiasihanoukvilletours.com,+855 96 595 9592,http://cambodiasihanoukvilletours.com,https://www.tripadvisor.com/UserReview-g325573-d8525957-CS_Tours-Sihanoukville_Sihanoukville_Province.html?m=66827,"{'geo_location_id': '325573', 'ranking_string': '#3 of 8 Classes &amp; Workshops in Sihanoukville', 'geo_location_name': 'Sihanoukville', 'ranking_out_of': '8', 'ranking': '3'}",5,https://www.tripadvisor.com/img/cdsi/img2/ratings/traveler/5.0-66827-5.svg,33,"{'1': '0', '2': '0', '3': '0', '4': '5', '5': '28'}",Not available,44,https://www.tripadvisor.com/Attraction_Review-g325573-d8525957-m66827-Reviews-CS_Tours-Sihanoukville_Sihanoukville_Province.html#photos,Not available,"{'periods': [{'open': {'day': 1, 'time': '0700'}, 'close': {'day': 1, 'time': '2100'}}, {'open': {'day': 2, 'time': '0700'}, 'close': {'day': 2, 'time': '2100'}}, {'open': {'day': 3, 'time': '0700'}, 'close': {'day': 3, 'time': '2100'}}, {'open': {'day': 4, 'time': '0700'}, 'close': {'day': 4, 'time': '2100'}}, {'open': {'day': 5, 'time': '0700'}, 'close': {'day': 5, 'time': '2100'}}, {'open': {'day': 6, 'time': '0700'}, 'close': {'day': 6, 'time': '2100'}}, {'open': {'day': 7, 'time': '0700'}, 'close': {'day': 7, 'time': '2100'}}], 'weekday_text': ['Monday: 07:00 - 21:00', 'Tuesday: 07:00 - 21:00', 'Wednesday: 07:00 - 21:00', 'Thursday: 07:00 - 21:00', 'Friday: 07:00 - 21:00', 'Saturday: 07:00 - 21:00', 'Sunday: 07:00 - 21:00']}",Not available,Not available,Not available,Not available,"{'name': 'attraction', 'localized_name': 'Attraction'}","[{'name': 'food_drink', 'localized_name': 'Food & Drink'}, {'name': 'classes', 'localized_name': 'Classes & Workshops'}, {'name': 'sightseeing_tours', 'localized_name': 'Tours'}, {'name': 'activities', 'localized_name': 'Activities'}]","[{'name': 'Food & Drink', 'localized_name': 'Food & Drink', 'categories': [{'name': 'Cooking Classes', 'localized_name': 'Cooking Classes'}]}, {'name': 'Classes & Workshops', 'localized_name': 'Classes & Workshops', 'categories': [{'name': 'Cooking