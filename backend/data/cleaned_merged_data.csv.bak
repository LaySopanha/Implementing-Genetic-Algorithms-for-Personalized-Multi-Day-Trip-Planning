sion', 'Wheelchair Accessible']","[{'name': 'bar', 'localized_name': 'Bar'}, {'name': 'cafe', 'localized_name': 'Cafe'}, {'name': 'asian', 'localized_name': 'Asian'}, {'name': 'pub', 'localized_name': 'Pub'}, {'name': 'healthy', 'localized_name': 'Healthy'}]",Not available,Not available,"{'name': 'restaurant', 'localized_name': 'Restaurant'}",Not available,Not available,Not available,[],"[{'name': 'business', 'localized_name': 'Business', 'value': '1'}, {'name': 'couples', 'localized_name': 'Couples', 'value': '5'}, {'name': 'solo', 'localized_name': 'Solo travel', 'value': '2'}, {'name': 'family', 'localized_name': 'Family', 'value': '1'}, {'name': 'friends', 'localized_name': 'Friends getaway', 'value': '6'}]",[],Not available,Not available,FALSE,38,6
Monorom 2 VIP Hotel,here:pds:place:116w64up-1741b508c6214512b153fe811aa1cb51,en,accommodation,"{'label': 'Monorom 2 VIP Hotel, ផ្លូវ 223, 030403 កំពង់ចាម, កម្ពុជា', 'countryCode': 'KHM', 'countryName': 'កម្ពុជា', 'county': 'កំពង់ចាម', 'city': 'កំពង់ចាម', 'district': 'សំបួរមាស', 'street': 'ផ្លូវ 223', 'postalCode': '030403'}","{'lat': 11.97787, 'lng': 105.4527}","[{'lat': 11.97798, 'lng': 105.45262}]",25261,"[{'id': '500-5000-0053', 'name': 'Hotel', 'primary': True}]",Not available,Not Available,[{'phone': [{'value': '+85592777102'}]}],Not Available,Kampong Cham,11.990282,105.46717,6877536,Monorom VIP Hotel,"Welcome to Monorom VIP Hotel, your Kampong Cham “home away from home.” Monorom VIP Hotel aims to make your visit as relaxing and enjoyable as possible, which is why so many guests continue to come back year after year.
Wat Nokor (2.0 mi), located nearby, makes Monorom VIP Hotel a great place to stay for those interested in visiting this popular Kampong Cham landmark.
The rooms offer a refrigerator and air conditioning, and getting online is possible, as free wifi is available, allowing you to rest and refresh with ease.
Monorom VIP Hotel features a 24 hour front desk, a concierge, and room service. Guests arriving by vehicle have access to free parking.
While in Kampong Cham be sure to experience local burritos favorites at Destiny Coffee House.
If you’re looking for things to do, you can check out Ko Paen Bamboo Bridge (0.9 mi) or The French Tower (0.7 mi), which are popular attractions amongst tourists, and they are all within walking distance.
Monorom VIP Hotel puts the best of Kampong Cham at your fingertips, making your stay both relaxing and enjoyable.
