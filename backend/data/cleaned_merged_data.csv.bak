Beer House No.1,here:pds:place:116w3fh6-4211b764401a4cd6912d243e6dc11b06,en,bar_pub,"{'label': 'Beer House No.1, 070801 កំពត, កម្ពុជា', 'countryCode': 'KHM', 'countryName': 'កម្ពុជា', 'county': 'កំពត', 'city': 'កំពត', 'district': 'កំពង់កណ្ដាល', 'postalCode': '070801'}","{'lat': 10.60688, 'lng': 104.17936}","[{'lat': 10.60675, 'lng': 104.17941}]",19703,"[{'id': '200-2000-0011', 'name': 'Bar or Pub', 'primary': True}]",Not available,Not Available,[{'phone': [{'value': '+85570676646'}]}],Not Available,Kampot,10.609713,104.18127,10755201,Aroma House,"Offering a new experience in dining for Kampot. All homemade from scratch using organic ingredients as much as possible. We make everything fresh everyday including our own bread, hummus and sauces.. no cans, or off the shelf ingredients. Whether you are vegetarian or meat lover, we have something to dazzle your taste buds. Welcome to Aroma House!",https://www.tripadvisor.com/Restaurant_Review-g608455-d10755201-Reviews-Aroma_House-Kampot_Kampot_Province.html?m=66827,"{'street1': '722 Street', 'street2': 'Mouy Osorphea Village', 'city': 'Kampot', 'state': 'Kampot Province', 'country': 'Cambodia', 'postalcode': '07000', 'address_string': '722 Street Mouy Osorphea Village, Kampot 07000 Cambodia'}","[{'level': 'City', 'name': 'Kampot', 'location_id': '608455'}, {'level': 'Province', 'name': 'Kampot Province', 'location_id': '2366664'}, {'level': 'Country', 'name': 'Cambodia', 'location_id': '293939'}]",Asia/Phnom_Penh,pitakampot@gmail.com,+855 78 796 440,http://www.facebook.com/aromakampot/,https://www.tripadvisor.com/UserReview-g608455-d10755201-Aroma_House-Kampot_Kampot_Province.html?m=66827,"{'geo_location_id': '608455', 'ranking_string': '#5 of 174 Places to Eat in Kampot', 'geo_location_name': 'Kampot', 'ranking_out_of': '174', 'ranking': '5'}",5,https://www.tripadvisor.com/img/cdsi/img2/ratings/traveler/5.0-66827-5.svg,623,"{'1': '1', '2': '5', '3': '16', '4': '65', '5': '540'}","{'0': {'name': 'rate_food', 'localized_nam