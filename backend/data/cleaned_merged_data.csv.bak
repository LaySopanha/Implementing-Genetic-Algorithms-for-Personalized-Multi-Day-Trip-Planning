Hak's Project,here:pds:place:116aabd1-301c3c1aa8a60522ed6746acfab9c719,en,guest_house,"{'label': ""Hak's Project, 170403 សូត្រនិគម, កម្ពុជា"", 'countryCode': 'KHM', 'countryName': 'កម្ពុជា', 'county': 'សៀមរាម', 'city': 'សូត្រនិគម', 'district': 'ដានរុន', 'postalCode': '170403'}","{'lat': 13.16341, 'lng': 104.13627}","[{'lat': 13.16345, 'lng': 104.13614}]",107039,"[{'id': '500-5100-0057', 'name': 'Guest House', 'primary': True}]",Not available,"[{'supplier': {'id': 'tripadvisor'}, 'id': '8611764'}]","[{'phone': [{'value': '+85592907301'}], 'www': [{'value': 'http://haksproject.org'}]}]",Not Available,Siem Reap,13.163298,104.13658,8611764,Hak's Project,"Welcome to Thnal Dach village! We run a small project for teaching English to children living in the village. Our homestay is in the heart of the village where the children come to learn. It is your choice, you can volunteer or just experience the village culture and the real Cambodia!",https://www.tripadvisor.com/Hotel_Review-g297390-d8611764-Reviews-Hak_s_Project-Siem_Reap_Siem_Reap_Province.html?m=66827,"{'street1': 'Thnal Dach Village', 'city': 'Siem Reap', 'state': 'Siem Reap Province', 'country': 'Cambodia', 'address_string': 'Thnal Dach Village, Siem Reap Cambodia'}","[{'level': 'Municipality', 'name': 'Siem Reap', 'location_id': '297390'}, {'level': 'Province', 'name': 'Siem Reap Province', 'location_id': '2366676'}, {'level': 'Country', 'name': 'Cambodia', 'location_id': '293939'}]",Asia/Phnom_Penh,Not available,Not available,Not available,https://www.tripadvisor.com/UserReview-g297390-d8611764-Hak_s_Project-Siem_Reap_Siem_Reap_Province.html?m=66827,"{'geo_location_id': '297390', 'ranking_string': '#361 of 644 B&Bs / Inns in Siem Reap', 'geo_location_name': 'Siem Reap', 'ranking_out_of': '644', 'ranking': '361'}",5,https://www.tripadvisor.com/img/cdsi/img2/ratings/traveler/5.0-66827-5.svg,1,"{'1': '0', '2': '0', '3': '0', '4': '0', '5': '1'}","{'0': {'name': 'rate_location', 'localized_name': 'Location', 'ratin