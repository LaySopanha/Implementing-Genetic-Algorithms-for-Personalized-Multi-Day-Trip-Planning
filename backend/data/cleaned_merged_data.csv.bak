raveler/ss4.5.svg', 'value': '4.5'}}",351,https://www.tripadvisor.com/Hotel_Review-g303666-d629837-m66827-Reviews-La_Villa_Battambang-Battambang_Battambang_Province.html#photos,$,Not available,"['Pool', 'Internet', 'Free Internet', 'Restaurant', 'Wifi', 'Free Wifi', 'Bar/Lounge', 'Breakfast included', 'Non-smoking rooms', 'Laundry Service', 'Air conditioning', 'Multilingual Staff', 'Minibar', 'Safe', 'Flatscreen TV', 'Outdoor pool', 'English', 'Pool / Beach Towels', 'Sun Umbrellas', 'Suites', 'Breakfast Available']",Not available,Not available,Not available,"{'name': 'hotel', 'localized_name': 'Hotel'}","[{'name': 'bb', 'localized_name': 'Bed and Breakfast'}]",Not available,"['Historic Hotel', 'Quirky Hotels']",[],Not available,Not available,Not available,Not available,FALSE,25,1
La Villa Battambang Restaurant,here:pds:place:116w636s-a4a50ef374a040a7a3e3a6c59d390330,en,restaurant,"{'label': 'La Villa Battambang Restaurant, 021403 បាត់ដំបង, កម្ពុជា', 'countryCode': 'KHM', 'countryName': 'កម្ពុជា', 'county': 'បាត់ដំបង', 'city': 'បាត់ដំបង', 'district': 'រតនៈ', 'postalCode': '021403'}","{'lat': 13.09841, 'lng': 103.20048}","[{'lat': 13.09843, 'lng': 103.20034}]",12575,"[{'id': '100-1000-0000', 'name': 'Restaurant', 'primary': True}, {'id': '700-7200-0253', 'name': 'Catering & Other Food Services'}]","[{'id': '200-000', 'name': 'Asian', 'primary': True}, {'id': '256-000', 'name': 'Cambodian'}, {'id': '301-000', 'name': 'French'}]","[{'supplier': {'id': 'tripadvisor'}, 'id': '1219842'}]","[{'phone': [{'value': '+85553730151'}], 'www': [{'value': 'http://www.lavilla-battambang.com', 'categories': [{'id': '700-7200-0253'}]}]}]","[{'categories': [{'id': '100-1000-0000'}], 'text': ['Mon-Sun: 07:00 - 22:00'], 'isOpen': True, 'structured': [{'start': 'T070000', 'duration': 'PT15H00M', 'recurrence': 'FREQ:DAILY;BYDAY:MO,TU,WE,TH,FR,SA,SU'}]}]",Battambang,13.098383,103.20079,1219842,La Villa Battambang Restaurant,"La Villa was constructed in the 1930's by a tradesman from Battambang, this colonial architecture was very fashionable during the French colonial period. The proprietor, Mr Eap Heo later bequeathed his home to his two youngest children who then lived in the residence till the coup d'etat in 1975. After the Khmer rouge period, the house became the general quarters for the Vietnamese army. It was given to a Cambodian general after their departure. For many years, the house was partially leased and squatted before it was sold in 2004 to a young expatriate couple who were mesmerized by the charm and beauty of this ancient house. After significant renovations, the house and its outbuildings regained its splendor in the form of a charming 7 bedroom guest house with a swimming pool that will captivate anyone that would like to re-live and experience an Indochinese atmosphere. We have recreated the same ambiance that the house would have had in the 1930's with Art deco furniture, electrical e",https://www.tripadvisor.com/Restaurant_Review-g303666-d1219842-Reviews-La_Villa_Battambang_Restaurant-Battambang_Battambang_Province.html?m=66827,"{'street1': '#159d', 'street2': '', 'city': 'Battambang', 'state': 'Battambang Province', 'country': 'Cambodia', 'postalcode': '02353', 'address_string': '#159d, Battambang 02353 Cambodia'}","[{'level': 'City', 'name': 'Battambang', 'location_id': '303666'}, {'level': 'Province', 'name': 'Battambang Province', 'location_id': '2366626'}, {'level': 'Country', 'name': 'Cambodia', 'location_id': '293939'}]",Asia/Phnom_Penh,lavilla.battambang@gmail.com,+855 53 730 151,Not available,https://www.tripadvisor.com/UserReview-g303666-d1219842-La_Villa_Battambang_Restaurant-Battambang_Battambang_Province.html?m=66827,"{'geo_location_id': '303666', 'ranking_string': '#26 of 138 Places to Eat in Battambang', 'geo_location_name': 'Battambang', 'ranking_out_of': '138', 'ranking': '26'}",4,https://www.tripadvisor.com/img/cdsi/img2/ratings/traveler/4.0-66827-5.svg,155,"{'1': '5', '2': '10', '3': '25', '4': '38', '5': '77'}","{'0': {'name': 'rate_atmosphere', 'localized_name': 'Atmosphere', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss4.5.svg', 'value': '4.5'}, '1': {'name': 'rate_food', 'localized_name': 'Food', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss4.0.svg', 'value': '4.0'}, '2': {'name': 'rate_service', 'localized_name': 'Service', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss4.5.svg', 'value': '4.5'}, '3': {'name': 'rate_value', 'localized_name': 'Value', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss4.0.svg', 'value': '4.0'}}",90,https://www.tripadvisor.com/Restaurant_Review-g303666-d1219842-m66827-Reviews-La_Villa_Battambang_Restaurant-Battambang_Battambang_Province.html#photos,$$ - $$$,"{