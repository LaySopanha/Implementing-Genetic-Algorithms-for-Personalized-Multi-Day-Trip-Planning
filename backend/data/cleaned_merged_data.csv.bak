.0.svg', 'value': '4.0'}, '2': {'name': 'rate_service', 'localized_name': 'Service', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss4.0.svg', 'value': '4.0'}, '3': {'name': 'rate_value', 'localized_name': 'Value', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss4.0.svg', 'value': '4.0'}}",46,https://www.tripadvisor.com/Restaurant_Review-g608456-d6703576-m66827-Reviews-La_Mouette_Seagull-Kep_Kep_Province.html#photos,$$ - $$$,Not available,"['Outdoor Seating', 'Reservations', 'Seating', 'Serves Alcohol', 'Table Service']","[{'name': 'seafood', 'localized_name': 'Seafood'}, {'name': 'asian', 'localized_name': 'Asian'}, {'name': 'cambodian', 'localized_name': 'Cambodian'}]",Not available,Not available,"{'name': 'restaurant', 'localized_name': 'Restaurant'}",Not available,Not available,Not available,[],"[{'name': 'business', 'localized_name': 'Business', 'value': '0'}, {'name': 'couples', 'localized_name': 'Couples', 'value': '29'}, {'name': 'solo', 'localized_name': 'Solo travel', 'value': '3'}, {'name': 'family', 'localized_name': 'Family', 'value': '7'}, {'name': 'friends', 'localized_name': 'Friends getaway', 'value': '14'}]",[],Not available,Not available,FALSE,38,8
La Muffins Bakery,here:pds:place:116d408k-8abfb30dc996010017636421e6b60e3a,en,casual_dining,"{'label': 'La Muffins Bakery, 080315 កណ្ដាលស្ទឹង, កម្ពុជា', 'countryCode': 'KHM', 'countryName': 'កម្ពុជា', 'county': 'កណ្ដាល', 'city': 'កណ្ដាលស្ទឹង', 'district': 'សៀមរាប', 'postalCode': '080315'}","{'lat': 11.4, 'lng': 104.867}","[{'lat': 11.40137, 'lng': 104.86629}]",65936,"[{'id': '100-1000-0001', 'name': 'Casual Dining', 'primary': True}, {'id': '100-1000-0000', 'name': 'Restaurant'}, {'id': '200-2000-0000', 'name': 'Nightlife-Entertainment'}]",Not available,Not Available,[{'phone': [{'value': '+85581970553'}]}],Not Available,Kandal,11.46727,104.92883,25631799,La table cafe,"Garden Cafe/ Bar/ Restaurant in the river border. Enjoy all our seat area, private salon in the garden or in the restaurant from the 2 seats tables to be Intime to 16 seats tables. Perfect for families, couple, big friends groups, sports team or more. Vegetarian friendly. Many dishes with organic flowers and aromatics herbs from our garden. Large varieties of house made products as syrups from our garden's flowers. ice cream, jam, even soon cake, vegan cake and infused local alcohol. We have more than 200 plants and trees species and more than 50 flowers species. If you love the green and nice oxygen we are definitely the place to be. We are organizing a tour to discover edibles flowers, medicinal plants from our garden""",https://www.tripadvisor.com/Restaurant_Review-g729355-d25631799-Reviews-La_table_cafe-Ta_Khmau_Kandal_Province.html?m=66827,"{'street1': '#193 Prek kat', 'city': 'Ta Khmau', 'state': 'Kandal Province', 'country': 'Cambodia', 'address_string': '#193 Prek kat, Ta Khmau Cambodia'}","[{'level': 'City', 'name': 'Ta Khmau', 'location_id': '729355'}, {'level': 'Province', 'name': 'Kandal Province', 'location_id': '2366665'}, {'level': 'Country', 'name': 'Cambodia', 'location_id': '293939'}]",Asia/Phnom_Penh,Not available,+855 12 872 767,Not available,https://www.tripadvisor.com/UserReview-g729355-d25631799-La_table_cafe-Ta_Khmau_Kandal_Province.html?m=66827,Not available,0,Not available,Not available,Not available,{},0,https://www.tripadvisor.com/Restaurant_Review-g729355-d25631799-m66827-Reviews-La_table_cafe-Ta_Khmau_Kandal_Province.html#photos,Not available,"{'periods': [{'open': {'day': 1, 'time': '0700'}, 'close': {'day': 1, 'time': '2200'}}, {'open': {'day': 2, 'time': '0700'}, 'close': {'day': 2, 'time': '2200'}}, {'open': {'day': 3, 'time': '0700'}, 'close': {'day': 3, 'time': '2200'}}, {'open': {'day': 4, 'time': '0700'}, 'close': {'day': 4, 'time': '2200'}}, {'open': {'day': 5, 'time': '0700'}, 'close': {'day': 5, 'time': '2200'}}, {'open': {'day': 6, 'time': '0700'}, 'close': {'day': 6, 'time': '2200'}}, {'open': {'day': 7, 'time': '0700'}, 'close': {'day': 7, 'time': '2200'}}], 'weekday_text': ['Monday: 07:00 - 22:00', 'Tuesday: 07:00 - 22:00', 'Wednesday: 07:00 - 22:00', 'Thursday: 07:00 - 22:00', 'Friday: 07:00 - 22:00', 'Saturday: 07:00 - 22:00', 'Sunday: 07:00 - 22:00']}","['Cash Only', 'Digital Payments', 'Free Wifi', 'Full Bar', 'Non-smoking restaurants', 'Outdoor Seating', 'Parking Available', 'Private Dining', 'Reservations', 'Seating', 'Serves Alcohol', 'Television', 'Wheelchair Accessible', 'Wine and Beer']","[{'name': 'international', 'localized_name': 'International'}, {'name': 'asian', 'localized_name': 'Asian'}]",Not available,Not available,"{'name': 'restaurant', 'localized_name': 'Restaurant'}",Not available,Not available,Not available,[],"[{'name': 'business', 'localized_name': 'Business', 'value': '0'}, {'name': 'couples', 'localized_name': 'Couples', 'value': '0'}, {'name': 'solo', 'localized_name': 'Solo travel', 'value': '0'}, {'name': 'family', 'localized_name': 'Family', 'value': '0'}, {'name': 'friends', 'localized_name': 'Friends getaway', 'value': '0'}]",[],Not available,Not available,FALSE,20,7
La Palmeraie D'Angkor,here:pds:place:116aabd1-ea11e3610d5c02fd68e3bd6e31d2a528,en,accommodation,"{'label': ""La Palmeraie D'Angkor, 171210 សៀមរាប, កម្ពុជា"", 'countryCode': 'KHM', 'countryName': 'កម្ពុជា', 'county': 'សៀមរាម', 'city': 'សៀមរាប', 'district': 'ស្រងែ', 'postalCode': '171210'}","{'lat': 13.3839, 'lng': 103.81679}","[{'lat': 13.38403, 'lng': 103.81678}]",86675,"[{'id': '500-5000-0053', 'name': 'Hotel', 'primary': True}, {'id': '500-5100-0058', 'name': 'Bed and Breakfast'}]",Not available,"[{'supplier': {'id': 'tripadvisor'}, 'id': '1534782'}]",[{'phone': [{'value': '+85592952113'}]}],Not Available,Siem Reap,13.383665,103.81681,1534782,La Palmeraie d'Angkor,"LA PALMERAIE was created as a unique dream getaway, far from the maddening crowds, in a lush tropical settings. Comfort, elegance and space await you in a zen-like, cosy and romantic atmosphere. Whether you are traveling alone, in a couple, or with family, you will find a calm and peaceful respite with personalized service at its very best. The 4.500 square meter site comprises a main villa, two secondary villas, a small cottage, two swimming pools, and a restaurant-bar which offers a daily selection of fine Asian cuisine. LA PALMERAIE offers single or double rooms, a small cottage for four, a private villa for eight or the entire domain for twenty.",https://www.tripadvisor.com/Hotel_Review-g297390-d1534782-Reviews-La_Palmeraie_d_Angkor-Siem_Reap_Siem_Reap_Province.html?m=66827,"{'street1': '6 Phum Thnaol - Route Nationale', 'street2': 'Airport Road', 'city': 'Siem Reap', 'state': 'Siem Reap Province', 'country': 'Cambodia', 'postalcode': '17000', 'address_string': '6 Phum Thnaol - Route Nationale Airport Road, Siem Reap 17000 Cambodia'}","[{'level': 'Municipality', 'name': 'Siem Reap', 'location_id': '297390'}, {'level': 'Province', 'name': 'Siem Reap Province', 'location_id': '2366676'}, {'level': 'Country', 'name': 'Cambodia', 'location_id': '293939'}]",Asia/Phnom_Penh,Not available,Not available,Not