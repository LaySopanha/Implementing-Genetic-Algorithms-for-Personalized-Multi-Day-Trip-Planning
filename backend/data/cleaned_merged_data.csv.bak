rvice', 'Takeout', 'Wheelchair Accessible']",Not available,Not available,Not available,"{'name': 'restaurant', 'localized_name': 'Restaurant'}","[{'name': 'sit_down', 'localized_name': 'Sit down'}]",Not available,Not available,[],"[{'name': 'business', 'localized_name': 'Business', 'value': '20'}, {'name': 'couples', 'localized_name': 'Couples', 'value': '113'}, {'name': 'solo', 'localized_name': 'Solo travel', 'value': '42'}, {'name': 'family', 'localized_name': 'Family', 'value': '32'}, {'name': 'friends', 'localized_name': 'Friends getaway', 'value': '93'}]",[],Not available,Not available,FALSE,38,2
Smiley's Guesthouse,here:pds:place:116w63u5-90ee712d35654a9faf7ee02f1006e059,en,guest_house,"{'label': ""Smiley's Guesthouse, 171202 សៀមរាប, កម្ពុជា"", 'countryCode': 'KHM', 'countryName': 'កម្ពុជា', 'county': 'សៀមរាម', 'city': 'សៀមរាប', 'district': 'ស្វាយដង្គំ', 'postalCode': '171202'}","{'lat': 13.36117, 'lng': 103.85291}","[{'lat': 13.36111, 'lng': 103.85303}]",24415,"[{'id': '500-5100-0057', 'name': 'Guest House', 'primary': True}]",Not available,"[{'supplier': {'id': 'tripadvisor'}, 'id': '317858'}]","[{'phone': [{'value': '+85512852955'}], 'www': [{'value': 'https://www.facebook.com/Smileys-Guesthouse-Page-133566707288776'}]}]",Not Available,Siem Reap,13.360998,103.852905,317858,Smiley's Guesthouse,"If you’re looking for a budget friendly guest house in Siem Reap, look no further than Smiley's Guesthouse.
Close to some of Siem Reap's most popular landmarks, such as Wat Preah Prom Rath (0.5 mi) and Viti's Tuk Tuk Driver (0.6 mi), Smiley's Guesthouse is a great destination for tourists.
Guest rooms offer amenities such as air conditioning, and guests can go online with free wifi offered by the guest house.
Smiley`s Guesthouse Hotel features a 24 hour front desk, room service, and baggage storage, to help make your stay more enjoyable. The property also boasts a pool and an on-site restaurant.
While in Siem Reap be sure to experience local dumplings  favorites at Marum, Khmer Kitchen Restaurant, or Spoons.
There is no shortage of things to do in the area: explore popular art galleries such as Angkor Artwork E&T Stocker, Theam's House, and Jayav Art.
The staff at Smiley's Guesthouse looks forward to serving you during your upcoming visit.
",https://www.tripadvisor.com/Hotel_Review-g297390-d317858-Reviews-Smiley_s_Guesthouse-Siem_Reap_Siem_Reap_Province.html?m=66827,"{'street1': 'Tapol Street', 'street2': 'Taphul Village, Svaydonkom', 'city': 'Siem Reap', 'state': 'Siem Reap Province', 'country': 'Cambodia', 'address_string': 'Tapol Street Taphul Village, Svaydonkom, Siem Reap Cambodia'}","[{'level': 'Municipality', 'name': 'Siem Reap', 'location_id': '297390'}, {'level': 'Province', 'name': 'Siem Reap Province', 'location_id': '2366676'}, {'level': 'Country', 'name': 'Cambodia', 'location_id': '293939'}]",Asia/Phnom_Penh,Not available,Not available,Not available,https://www.tripadvisor.com/UserReview-g297390-d317858-Smiley_s_Guesthouse-Siem_Reap_Siem_Reap_Province.html?m=66827,"{'geo_location_id': '297390', 'ranking_string': '#314 of 644 B&Bs / Inns in Siem Reap', 'geo_location_name': 'Siem Reap', 'ranking_out_of': '644', 'ranking': '314'}",3,https://www.tripadvisor.com/img/cdsi/img2/ratings/traveler/3.0-66827-5.svg,110,"{'1': '21', '2': '19', '3': '16', '4': '34', '5': '20'}","{'0': {'name': 'rate_location', 'localized_name': 'Location', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss3.5.svg', 'value': '3.5'}, '1': {'name': 'rate_sleep', 'localized_name': 'Sleep Quality', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss3.5.svg', 'value': '3.5'}, '2': {'name': 'rate_room', 'localized_name': 'Rooms', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss3.5.svg', 'value': '3.5'}, '3': {'name': 'rate_service', 'localized_name': 'Service', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss3.0.svg', 'value': '3.0'}, '4': {'name': 'rate_value', 'localized_name': 'Value', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss3.5.svg', 'value': '3.5'}, '5': {'name': 'rate_cleanliness', 'localized_name': 'Cleanliness', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss3.0.svg', 'value': '3.0'}}",212,https://www.tripadvisor.com/Hotel_Review-g297390-d317858-m66827-Reviews-Smiley_s_Guesthouse-Siem_Reap_Siem_Reap_Province.html#photos,$,Not available,"['Pool', 'Free parking', 'Restaurant', 'Airport transportation', 'Public Wifi', 'Free Wifi', 'Non-smoking rooms', 'Air conditioning', 'Internet', 'Free Internet', 'Wifi', 'Laundry Service', 'Concierge', 'Family Rooms', 'Non-smoking hotel', 'Safe', 'Kids pool', 'Baggage Storage', 'Bottled Water', 'Car Hire', 'Coffee Shop', 'English', 'Fence Around Pool', 'French', '24-Hour Front Desk', 'Ironing Service', 'Khmer', 'Massage', 'Pool with View', 'Saltwater Pool', 'Sun Terrace', 'Thai']",Not available,Not available,Not available,"{'name': 'hotel', 'localized_name': 'Hotel'}","[{'name': 'bb', 'localized_name': 'Bed and Breakfast'}]",Not available,"['Budget', 'Family']",[],"[{'name': 'business', 'localized_name': 'Business', 'value': '4'}, {'name': 'couples', 'localized_name': 'Couples', 'value': '39'}, {'name': 'solo', 'localized_name': 'Solo travel', 'value': '24'}, {'name': 'family', 'localized_name': 'Family', 'value': '4'}, {'name': 'friends', 'localized_name': 'Friends getaway', 'value': '18'}]",[],Not available,Not available,FALSE,25,20
Smiling Hotel,here:pds:place:116aabd1-8affbf64ce650601637f1715461af099,en,accommodation,"{'label': 'Smiling Hotel, ផ្លូវ សម្តេចវិបុលបញ្ញា សុខ អាន, 171201 សៀមរាប, កម្ពុជា', 'countryCode': 'KHM', 'countryName': 'កម្ពុជា', 'county': 'សៀមរាម', 'city': 'សៀមរាប', 'district': 'ស្លក្រាម', 'street': 'ផ្លូវ សម្តេចវិបុលបញ្ញា សុខ អាន', 'postalCode': '171201'}","{'lat': 13.35972, 'lng': 103.87927}","[{'lat': 13.35972, 'lng': 103.87941}]",131835,"[{'id': '500-5000-0053', 'name': 'Hotel', 'primary': True}]",Not available,"[{'supplier': {'id': 'tripadvisor'}, 'id': '1379768'}]","[{'phone': [{'value': '+85516376868'}], 'www': [{'value': 'https://www.facebook.com/smilinghotel'}]}]",Not Available,Siem Reap,13.3593,103.87906,1379768,Smiling Hotel,"Nestled within the city center on the main Street and a peaceful location, Smiling Hotel offers stylish and luxury accommodations away from the hustle and bustle of Siem Reap. It features 2 Free-form outdoor pools and guests can enjoy meals at the well-decorated in-house restaurant or have a drink at the bar or lounge. Free WiFi is available throughout the property. Featuring Khmer Decor, rooms are luxuriously decorated with antique furniture and classic artwork and facilitated with high quality premium linen and bedding material for guests' comfort. All rooms and suites come with air conditioning, antique-style tiles and hardwood flooring, a flat-screen cable TV and a writing desk. Some units have a seating area and private balcony with a lounge area for relaxing or dining that opens up to views of the swimming pool and garden. Private bathrooms include a rain shower, beautiful vanity counter, and a full range of bathroom amenities, slipper and toiletry. Guests can approach the 24-hour front desk for tour arrangements, free shoe-shine service, laundry, currency exchange, ticketing and concierge services. Additionally, guests can rent bicycles to explore the surrounding area or learn how to make local dishes at the cooking class. Guests can enjoy Cambodian and Western dishes at Smiling Cafe Dinning Restaurant or indulge in massage treatments by professional massage therapists at Smiling Spa. The property is located close to several tourist attractions such as 800 m from the Palm container Night Market as well the temple entrance check-point, 900 m from the Angkor Museum of Art, 1.1 km from the King Preah Norodom Sihanouk’s Museum and 6 km from Angkor Wat. Angkor National Museum is 2 km from Smiling Hotel. The vibrant Pub Street and Old Market are 3 km from the property. Siem Reap - Angkor International Airport is 10 km away. The property offers complimentary one-way airport transfers by hotel mini-van or by Tuk Tuk.",https://www.tripadvisor.com/Hotel_Review-g297390-d1379768-Reviews-Smiling_Hotel-Siem_Reap_Siem_Reap_Province.html?m=66827,"{'street1': 'National Road No. 6', 'street2': 'Chong Kaosou Village, Sangkat Slor Kram', 'city': 'Siem Reap', 'state': 'Siem Reap Province', 'country': 'Cambodia', 'postalcode': '17252', 'address_string': 'National Road No. 6 Chong Kaosou Village, Sangkat Slor Kram, Siem Reap 17252 Cambodia'}","[{'level': 'Municipality', 'name': 'Siem Reap', 'location_id': '297390'}, {'level': 'Province', 'name': 'Siem Reap Province', 'location_id': '2366676'}, {'level': 'Country', 'name': 'Cambodia', 'location_id': '293939'}]",Asia/Phnom_Penh,Not available,Not available,Not available,https://www.tripadvisor.com/UserReview-g297390-d1379768-Smiling_Hotel-Siem_Reap_Siem_Reap_Province.html?m=66827,"{'geo_location_id': '297390', 'ranking_string': '#297 of 763 hotels in Siem Reap', 'geo_location_name': 'Siem Reap', 'ranking_out_of': '763', 'ranking': '297'}",4,https://www.tripadvisor.com/img/cdsi/img2/ratings/traveler/4.0-66827-5.svg,148,"{'1': '2', '2': '13', '3': '32', '4': '46', '5': '55'}","{'0': {'name': 'rate_sleep', 'localized_name': 'Sleep Quality', 'rating_image_url': 'https://static.tacdn.com/img2/ratings/traveler/ss4.0.svg', 'value': '4.0'}, '1': {'name': 'rate_location', 'localiz